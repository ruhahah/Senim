{
  "manifest_version": 3,
  "name": "Senim — проверка ответов ИИ",
  "short_name": "Senim",
  "version": "0.3.0",
  "description": "Кнопка «Проверить в Senim» прямо под ответом ChatGPT и Gemini: ошибки подсвечиваются в тексте. Или выделите любой ответ ИИ → «Проверить в Senim». Фото, скриншот, PDF и Word — через кнопку расширения. Қазақша · Русский · English.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Senim",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://senim-616q.onrender.com/*"
  ]
}